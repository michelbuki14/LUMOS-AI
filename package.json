{
  "name": "lumos-ai",
  "version": "1.0.0",
  "private": true,
  "description": "LUMOS AI — AI Operating System for Professional Photography",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:ai\" \"pnpm dev:desktop\"",
    "dev:api": "pnpm --filter @lumos/api dev",
    "dev:ai": "pnpm --filter @lumos/ai dev",
    "dev:desktop": "pnpm --filter @lumos/desktop dev",
    "dev:render": "pnpm --filter @lumos/render dev",
    "build": "pnpm --recursive build",
    "build:api": "pnpm --filter @lumos/api build",
    "build:ai": "pnpm --filter @lumos/ai build",
    "build:desktop": "pnpm --filter @lumos/desktop build",
    "build:render": "pnpm --filter @lumos/render build",
    "test": "pnpm --recursive test",
    "test:api": "pnpm --filter @lumos/api test",
    "test:ai": "pnpm --filter @lumos/ai test",
    "test:desktop": "pnpm --filter @lumos/desktop test",
    "lint": "pnpm --recursive lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,py,rs}\"",
    "db:migrate": "pnpm --filter @lumos/api db:migrate",
    "db:seed": "pnpm --filter @lumos/api db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "clean": "pnpm --recursive clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {}
}
