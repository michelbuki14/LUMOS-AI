{
  "name": "lumos-ai",
  "version": "1.0.0",
  "private": true,
  "description": "LUMOS AI \u2014 AI Operating System for Professional Photography",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./workspace.ps1 dev",
    "up": "powershell -ExecutionPolicy Bypass -File ./workspace.ps1 up",
    "run": "powershell -ExecutionPolicy Bypass -File ./workspace.ps1 run",
    "clean": "powershell -ExecutionPolicy Bypass -File ./workspace.ps1 clean",
    "check": "powershell -ExecutionPolicy Bypass -File ./workspace.ps1 check",
    "test": "flutter test",
    "analyze": "flutter analyze"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {}
}