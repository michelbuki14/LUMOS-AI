{
  "name": "@lumos/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "uvicorn lumos.app:app --reload --host 0.0.0.0 --port 8000",
    "start": "uvicorn lumos.app:app --host 0.0.0.0 --port 8000",
    "test": "pytest tests/ -v --cov=lumos --cov-report=term-missing",
    "lint": "ruff check lumos/",
    "format": "black lumos/",
    "typecheck": "mypy lumos/",
    "db:migrate": "alembic upgrade head",
    "db:seed": "python scripts/seed.py"
  }
}
