# LUMOS AI — AI Inference Service
FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y libgl1 libglib2.0-0 curl && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir structlog redis httpx fastapi uvicorn python-multipart pydantic numpy pillow opencv-python-headless || true
RUN pip install --no-cache-dir -r requirements.txt || pip install --no-cache-dir structlog redis httpx
COPY lumos ./lumos
RUN mkdir -p /app/models
EXPOSE 8001
CMD ["uvicorn", "lumos.ai.app:app", "--host", "0.0.0.0", "--port", "8001"]
