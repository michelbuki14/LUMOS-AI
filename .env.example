# LUMOS AI — Environment Configuration
# Copy this file to .env and customize for your setup

# =============================================================================
# Application
# =============================================================================
APP_NAME=LUMOS AI
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change_this_to_a_random_64_char_string_in_production_abcdefghijklmnopqrstuvwxyz1234567890

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://lumos:lumos_dev_password@localhost:5432/lumos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lumos
DB_USER=lumos
DB_PASSWORD=lumos_dev_password

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# Object Storage (MinIO / S3)
# =============================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=lumos
MINIO_SECRET_KEY=lumos_dev_password
MINIO_BUCKET=lumos-assets
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# =============================================================================
# Authentication
# =============================================================================
JWT_SECRET=change_this_to_a_random_64_char_string_in_production_abcdefghijklmnopqrstuvwxyz1234567890
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=

# =============================================================================
# AI Service
# =============================================================================
AI_SERVICE_URL=http://localhost:8001
AI_MODEL_CACHE_DIR=./models
AI_INFERENCE_DEVICE=cuda
AI_BATCH_SIZE=8
AI_MAX_IMAGE_SIZE=8192

# =============================================================================
# Rendering Engine (Rust)
# =============================================================================
RENDER_SERVICE_URL=http://localhost:8002
RENDER_DEVICE=vulkan
RENDER_TILE_SIZE=1024
RENDER_MEMORY_LIMIT_MB=4096

# =============================================================================
# Desktop App (Flutter)
# =============================================================================
DESKTOP_API_URL=http://localhost:8000
DESKTOP_WS_URL=ws://localhost:8000/ws
DESKTOP_RENDER_URL=http://localhost:8002

# =============================================================================
# Email (SMTP)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@lumos.ai

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_AI_FEATURES=true
ENABLE_CLOUD_SYNC=false
ENABLE_MARKETPLACE=false
ENABLE_ENTERPRISE=false
ENABLE_OFFLINE_MODE=true
ENABLE_TELEMETRY=false

# =============================================================================
# Performance
# =============================================================================
WORKERS=4
MAX_CONCURRENT_UPLOADS=10
CACHE_TTL_SECONDS=3600
IMAGE_PREVIEW_QUALITY=85
THUMBNAIL_SIZE=512

# =============================================================================
# Security
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
ENCRYPTION_KEY=
