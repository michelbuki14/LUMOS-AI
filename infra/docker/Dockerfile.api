# LUMOS AI — FastAPI Backend
FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y libraw-dev libtiff-dev libjpeg-dev libpng-dev libwebp-dev libheif-dev libmagickwand-dev libgl1 libglib2.0-0 curl && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir -r requirements.txt
COPY lumos ./lumos
RUN mkdir -p /app/storage
EXPOSE 8000
CMD ["uvicorn", "lumos.app:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
